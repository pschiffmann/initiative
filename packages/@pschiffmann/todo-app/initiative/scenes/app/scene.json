{
  "inputs": {},
  "rootNode": "TodoHelpers",
  "nodes": {
    "TodoHelpers": {
      "type": "@pschiffmann/todo-app::TodoHelpers",
      "inputs": {},
      "slots": {
        "child": "TodoRepositoryBloc"
      }
    },
    "TodoRepositoryBloc": {
      "type": "@pschiffmann/todo-app::TodoRepositoryBloc",
      "inputs": {},
      "slots": {
        "child": "PageLayout"
      }
    },
    "PageLayout": {
      "type": "@initiative.dev/lib-mui-material::FlexContainer",
      "inputs": {
        "flexDirection": {
          "type": "enum-value",
          "value": "column"
        },
        "gap": {
          "type": "json-literal",
          "schemaName": "@initiative.dev/std::number",
          "value": 1
        },
        "padding": {
          "type": "json-literal",
          "schemaName": "@initiative.dev/std::string",
          "value": "16px 0"
        },
        "backgroundColor": {
          "type": "json-literal",
          "schemaName": "@initiative.dev/std::string",
          "value": "background.paper"
        },
        "elevation": {
          "type": "enum-value",
          "value": 2
        },
        "borderRadius": {
          "type": "json-literal",
          "schemaName": "@initiative.dev/std::number",
          "value": 2
        },
        "alignSelf::2": {
          "type": "enum-value",
          "value": "start"
        },
        "margin::2": {
          "type": "json-literal",
          "schemaName": "@initiative.dev/std::string",
          "value": "0 12px"
        }
      },
      "slots": {
        "child::0": "Header",
        "child::1": "EmptyStateSwitch",
        "child::2": "NewTodoDialog"
      }
    },
    "Header": {
      "type": "@initiative.dev/lib-mui-material::FlexContainer",
      "inputs": {
        "flexDirection": {
          "type": "enum-value",
          "value": "row"
        },
        "alignItems": {
          "type": "enum-value",
          "value": "center"
        },
        "gap": {
          "type": "json-literal",
          "schemaName": "@initiative.dev/std::number",
          "value": 1
        },
        "padding": {
          "type": "json-literal",
          "schemaName": "@initiative.dev/std::string",
          "value": "0 20px"
        },
        "margin::0": {
          "type": "json-literal",
          "schemaName": "@initiative.dev/std::string",
          "value": "0 auto 0 0"
        }
      },
      "slots": {
        "child::0": "Title",
        "child::1": "TodoCount",
        "child::2": "ToggleCompletedButton"
      }
    },
    "EmptyStateSwitch": {
      "type": "@initiative.dev/lib-core::Switch",
      "inputs": {
        "showIf::0": {
          "type": "node-output",
          "nodeId": "TodoRepositoryBloc",
          "outputName": "isEmpty",
          "selectors": []
        },
        "showIf::1": {
          "type": "json-literal",
          "schemaName": "@initiative.dev/std::boolean",
          "value": true
        }
      },
      "slots": {
        "case::0": "EmptyStateContainer",
        "case::1": "TodoList"
      }
    },
    "NewTodoDialog": {
      "type": "@initiative.dev/lib-mui-material::Dialog",
      "inputs": {
        "title": {
          "type": "fluent-message",
          "messages": {
            "en": "Add task",
            "de": "Aufgabe hinzufügen"
          },
          "args": {}
        }
      },
      "slots": {
        "trigger": "OpenNewTodoDialog",
        "content": "CreateTodoBloc"
      }
    },
    "Title": {
      "type": "@initiative.dev/lib-mui-material::Typography",
      "inputs": {
        "text": {
          "type": "json-literal",
          "schemaName": "@initiative.dev/std::string",
          "value": "Todo App"
        },
        "variant": {
          "type": "enum-value",
          "value": "h4"
        }
      },
      "slots": {}
    },
    "TodoCount": {
      "type": "@initiative.dev/lib-mui-material::Typography",
      "inputs": {
        "text": {
          "type": "fluent-message",
          "messages": {
            "en": "Completed: {$completed} / {$total}",
            "de": "Abgeschlossen: {$completed} / {$total}"
          },
          "args": {
            "completed": {
              "type": "node-output",
              "nodeId": "TodoRepositoryBloc",
              "outputName": "completedIds",
              "selectors": [
                {
                  "type": "property",
                  "propertyName": "length"
                }
              ]
            },
            "total": {
              "type": "node-output",
              "nodeId": "TodoRepositoryBloc",
              "outputName": "totalCount",
              "selectors": []
            }
          }
        }
      },
      "slots": {}
    },
    "ToggleCompletedButton": {
      "type": "@initiative.dev/lib-mui-material::IconButton",
      "inputs": {
        "label": {
          "type": "json-literal",
          "schemaName": "@initiative.dev/std::string",
          "value": ""
        },
        "icon": {
          "type": "fluent-message",
          "messages": {
            "en": "{$showCompleted ->\n  [true] visibility\n *[false] visibility_off\n}",
            "de": "{$showCompleted ->\n  [true] visibility\n *[false] visibility_off\n}"
          },
          "args": {
            "showCompleted": {
              "type": "node-output",
              "nodeId": "TodoRepositoryBloc",
              "outputName": "showCompleted",
              "selectors": [
                {
                  "type": "method",
                  "methodName": "toString",
                  "args": []
                }
              ]
            }
          }
        },
        "color": {
          "type": "enum-value",
          "value": "primary"
        },
        "size": {
          "type": "enum-value",
          "value": "small"
        },
        "onPress": {
          "type": "node-output",
          "nodeId": "TodoRepositoryBloc",
          "outputName": "toggleShowCompleted",
          "selectors": []
        }
      },
      "slots": {}
    },
    "EmptyStateContainer": {
      "type": "@initiative.dev/lib-mui-material::FlexContainer",
      "inputs": {
        "padding": {
          "type": "json-literal",
          "schemaName": "@initiative.dev/std::string",
          "value": "16px"
        }
      },
      "slots": {
        "child::0": "EmptyStateText"
      }
    },
    "TodoList": {
      "type": "@initiative.dev/lib-mui-material::CheckList",
      "inputs": {
        "items": {
          "type": "node-output",
          "nodeId": "TodoRepositoryBloc",
          "outputName": "visibleTodos",
          "selectors": []
        },
        "getItemKey": {
          "type": "node-output",
          "nodeId": "TodoHelpers",
          "outputName": "getId",
          "selectors": []
        },
        "getPrimaryText": {
          "type": "node-output",
          "nodeId": "TodoHelpers",
          "outputName": "getDescription",
          "selectors": []
        },
        "getSecondaryText": {
          "type": "node-output",
          "nodeId": "TodoHelpers",
          "outputName": "getCreatedAt",
          "selectors": []
        },
        "checked": {
          "type": "node-output",
          "nodeId": "TodoRepositoryBloc",
          "outputName": "completedIds",
          "selectors": []
        },
        "onCheckedChange": {
          "type": "node-output",
          "nodeId": "TodoRepositoryBloc",
          "outputName": "toggleCompleted",
          "selectors": []
        }
      },
      "slots": {
        "secondaryAction": "DeleteTodoButton"
      }
    },
    "OpenNewTodoDialog": {
      "type": "@initiative.dev/lib-mui-material::Button",
      "inputs": {
        "label": {
          "type": "fluent-message",
          "messages": {
            "en": "Add task",
            "de": "Neue Aufgabe"
          },
          "args": {}
        },
        "variant": {
          "type": "enum-value",
          "value": "contained"
        },
        "color": {
          "type": "enum-value",
          "value": "primary"
        },
        "startIcon": {
          "type": "json-literal",
          "schemaName": "@initiative.dev/std::string",
          "value": "add"
        },
        "onPress": {
          "type": "node-output",
          "nodeId": "NewTodoDialog",
          "outputName": "open",
          "selectors": []
        }
      },
      "slots": {}
    },
    "CreateTodoBloc": {
      "type": "@pschiffmann/todo-app::CreateTodoBloc",
      "inputs": {
        "createTodo": {
          "type": "node-output",
          "nodeId": "TodoRepositoryBloc",
          "outputName": "createTodo",
          "selectors": []
        },
        "closeDialog": {
          "type": "node-output",
          "nodeId": "NewTodoDialog",
          "outputName": "close",
          "selectors": []
        }
      },
      "slots": {
        "child": "NewTodoFormLayout"
      }
    },
    "EmptyStateText": {
      "type": "@initiative.dev/lib-mui-material::Typography",
      "inputs": {
        "text": {
          "type": "fluent-message",
          "messages": {
            "en": "Nothing left to do. Enjoy your day!",
            "de": "Alles Erledigt. Genieß den Tag!"
          },
          "args": {}
        },
        "color": {
          "type": "enum-value",
          "value": "text.secondary"
        }
      },
      "slots": {}
    },
    "DeleteTodoButton": {
      "type": "@initiative.dev/lib-mui-material::IconButton",
      "inputs": {
        "label": {
          "type": "json-literal",
          "schemaName": "@initiative.dev/std::string",
          "value": ""
        },
        "icon": {
          "type": "json-literal",
          "schemaName": "@initiative.dev/std::string",
          "value": "delete"
        },
        "color": {
          "type": "enum-value",
          "value": "error"
        },
        "size": {
          "type": "enum-value",
          "value": "small"
        },
        "onPress": {
          "type": "node-output",
          "nodeId": "TodoRepositoryBloc",
          "outputName": "deleteTodo",
          "selectors": [
            {
              "type": "call",
              "args": [
                {
                  "type": "node-output",
                  "nodeId": "TodoHelpers",
                  "outputName": "getId",
                  "selectors": [
                    {
                      "type": "call",
                      "args": [
                        {
                          "type": "node-output",
                          "nodeId": "TodoList",
                          "outputName": "item",
                          "selectors": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "slots": {}
    },
    "NewTodoFormLayout": {
      "type": "@initiative.dev/lib-mui-material::FlexContainer",
      "inputs": {
        "gap": {
          "type": "json-literal",
          "schemaName": "@initiative.dev/std::number",
          "value": 1
        },
        "padding": {
          "type": "json-literal",
          "schemaName": "@initiative.dev/std::string",
          "value": "8px 0 0 0"
        }
      },
      "slots": {
        "child::0": "NewTodoDescription",
        "child::1": "NewTodoSubmitButton"
      }
    },
    "NewTodoDescription": {
      "type": "@initiative.dev/lib-mui-material::TextField",
      "inputs": {
        "label": {
          "type": "fluent-message",
          "messages": {
            "en": "Description",
            "de": "Beschreibung"
          },
          "args": {}
        },
        "value": {
          "type": "node-output",
          "nodeId": "CreateTodoBloc",
          "outputName": "description$value",
          "selectors": []
        },
        "onChange": {
          "type": "node-output",
          "nodeId": "CreateTodoBloc",
          "outputName": "description$onChange",
          "selectors": []
        }
      },
      "slots": {}
    },
    "NewTodoSubmitButton": {
      "type": "@initiative.dev/lib-mui-material::Button",
      "inputs": {
        "label": {
          "type": "fluent-message",
          "messages": {
            "en": "Add",
            "de": "Hinzufügen"
          },
          "args": {}
        },
        "variant": {
          "type": "enum-value",
          "value": "contained"
        },
        "color": {
          "type": "enum-value",
          "value": "primary"
        },
        "onPress": {
          "type": "node-output",
          "nodeId": "CreateTodoBloc",
          "outputName": "submit",
          "selectors": []
        }
      },
      "slots": {}
    }
  }
}
